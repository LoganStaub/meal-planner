<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Home | Preply</title>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/index.css">
    <link rel="stylesheet" href="/css/recipe-details.css">
    <link rel="stylesheet" href="/css/page-card.css">
    <link rel="stylesheet" href="/css/page-header.css">
    <link rel="stylesheet" href="/css/profile-menu.css">
    <script src="/js/no-back-cache.js"></script>
</head>

<body>

    <!-- Icon set (Lucide-style line icons), used below with <svg><use href="#icon-..."> -->
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
        <symbol id="icon-x" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></symbol>
        <symbol id="icon-chevron-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
        <symbol id="icon-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
        <symbol id="icon-heart" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></symbol>
        <symbol id="icon-calendar-plus" viewBox="0 0 24 24"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8"/><path d="M3 10h18"/><path d="M16 19h6"/><path d="M19 16v6"/></symbol>
        <symbol id="icon-calendar" viewBox="0 0 24 24"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></symbol>
        <symbol id="icon-list" viewBox="0 0 24 24"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></symbol>
        <symbol id="icon-home" viewBox="0 0 24 24"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></symbol>
        <symbol id="icon-recipes" viewBox="0 0 24 24"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></symbol>
        <symbol id="icon-basket" viewBox="0 0 24 24"><path d="m15 11-1 9"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4"/><path d="M4.5 15.5h15"/><path d="m5 11 4-7"/><path d="m9 11 1 9"/></symbol>
    </svg>

    <div class="app">
        <%- include('partials/page-header', { pageTitle: 'Home' }) %>

        <main class="stage page-card" id="stage">

            <!-- The current meal. Swipe left/right (or drag with the mouse) to change it. -->
            <article class="slide" id="slide">
                <img class="photo" id="meal-photo" alt="" draggable="false">

                <div class="card">
                    <p class="meta">
                        <span class="meta-time" id="meal-time"></span><span class="meta-dot">·</span><span id="meal-tag"></span><span class="meta-dot">·</span><span id="meal-servings"></span>
                    </p>

                    <button type="button" class="summary" id="open-details" aria-haspopup="dialog">
                        <h2 class="recipe-title" id="meal-title"></h2>
                        <p class="recipe-desc" id="meal-desc"></p>
                    </button>

                    <div class="pantry-pill">
                        <span class="pantry-label">In pantry</span>
                        <span class="pantry-items" id="meal-pantry"></span>
                        <span class="pantry-buy" id="meal-buy"></span>
                    </div>

                    <div class="card-actions">
                        <button type="button" class="action-btn" id="next-btn" aria-label="Next meal">
                            <svg class="icon"><use href="#icon-x"/></svg>
                        </button>
                        <button type="button" class="action-btn primary-btn" id="calendar-btn">
                            <svg class="icon"><use href="#icon-calendar-plus"/></svg>
                            <span>Add to calendar</span>
                        </button>
                        <button type="button" class="action-btn like-btn" id="like-btn" aria-label="Like" aria-pressed="false">
                            <svg class="icon"><use href="#icon-heart"/></svg>
                        </button>
                    </div>
                </div>
            </article>

            <!-- Shown after swiping past the 5th meal -->
            <section class="done" id="done" hidden>
                <div class="done-card">
                    <h2>You're all caught up</h2>
                    <p>That's all 5 of <span id="done-picks-when">tonight's</span> picks. Check back tomorrow for more.</p>
                    <button type="button" class="action-btn primary-btn" id="restart-btn">See them again</button>
                </div>
            </section>

            <div class="top-scrim"></div>

            <header class="app-header">

                <div class="picks-row">
                    <%# index.js swaps this for the time of day (This morning's / This afternoon's / Tonight's) %>
                    <span class="picks-label" id="picks-label">Tonight's picks</span>
                    <span class="picks-count" id="picks-count"></span>
                </div>
                <div class="progress" id="progress"></div>
            </header>

            <!-- Previous / next buttons, only shown on computers -->
            <div class="stage-arrows">
                <button type="button" class="arrow-btn" id="prev-arrow" aria-label="Previous meal">
                    <svg class="icon"><use href="#icon-chevron-left"/></svg>
                </button>
                <button type="button" class="arrow-btn" id="next-arrow" aria-label="Next meal">
                    <svg class="icon"><use href="#icon-chevron-right"/></svg>
                </button>
            </div>
        </main>

        <nav class="nav" aria-label="Main">
            <p class="nav-brand"><img class="brand-logo" src="/images/logo.svg" alt="" width="28" height="28">Preply<span>.</span></p>
            <ul>
                <li><a class="nav-link" href="/calendar"><span class="nav-icon"><svg class="icon"><use href="#icon-calendar"/></svg></span>Calendar</a></li>
                <li><a class="nav-link" href="/shopping.html"><span class="nav-icon"><svg class="icon"><use href="#icon-list"/></svg></span>Shopping</a></li>
                <li class="nav-home"><a class="nav-link" href="/home" aria-current="page"><span class="nav-icon"><svg class="icon"><use href="#icon-home"/></svg></span>Home</a></li>
                <li><a class="nav-link" href="/recipes"><span class="nav-icon"><svg class="icon"><use href="#icon-recipes"/></svg></span>Recipes</a></li>
                <li><a class="nav-link" href="/pantry"><span class="nav-icon"><svg class="icon"><use href="#icon-basket"/></svg></span>Pantry</a></li>
            </ul>
        </nav>
    </div>

    <%# The recipe window and the "Add to calendar" popup (js/recipe-details.js) %>
    <%- include('partials/recipe-details') %>

    <%- include('partials/profile-menu') %>
    <script src="/js/profile-menu.js" defer></script>
    <script src="/js/recipe-details.js" defer></script>
    <script src="/js/index.js" defer></script>
</body>
</html>
