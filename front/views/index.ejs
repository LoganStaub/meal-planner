<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Meal Planner</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/index.css">
</head>

<body>

    <!-- Icon set (Lucide-style line icons), used below with <svg><use href="#icon-..."> -->
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
        <symbol id="icon-user" viewBox="0 0 24 24"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></symbol>
        <symbol id="icon-x" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></symbol>
        <symbol id="icon-chevron-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
        <symbol id="icon-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
        <symbol id="icon-heart" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></symbol>
        <symbol id="icon-calendar-plus" viewBox="0 0 24 24"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8"/><path d="M3 10h18"/><path d="M16 19h6"/><path d="M19 16v6"/></symbol>
        <symbol id="icon-calendar" viewBox="0 0 24 24"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></symbol>
        <symbol id="icon-list" viewBox="0 0 24 24"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></symbol>
        <symbol id="icon-home" viewBox="0 0 24 24"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></symbol>
        <symbol id="icon-search" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></symbol>
        <symbol id="icon-leaf" viewBox="0 0 24 24"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6C9.5 14.52 12 13 13 12"/></symbol>
        <symbol id="icon-sliders" viewBox="0 0 24 24"><path d="M21 4h-7"/><path d="M10 4H3"/><path d="M21 12h-9"/><path d="M8 12H3"/><path d="M21 20h-5"/><path d="M12 20H3"/><path d="M14 2v4"/><path d="M8 10v4"/><path d="M16 18v4"/></symbol>
        <symbol id="icon-bell" viewBox="0 0 24 24"><path d="M10.268 21a2 2 0 0 0 3.464 0"/><path d="M3.262 15.326A1 1 0 0 0 4 17h16a1 1 0 0 0 .74-1.673C19.41 13.956 18 12.499 18 8A6 6 0 0 0 6 8c0 4.499-1.411 5.956-2.738 7.326"/></symbol>
        <symbol id="icon-basket" viewBox="0 0 24 24"><path d="m15 11-1 9"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4"/><path d="M4.5 15.5h15"/><path d="m5 11 4-7"/><path d="m9 11 1 9"/></symbol>
    </svg>

    <div class="app">

        <main class="stage" id="stage">

            <!-- The current meal. Swipe left/right (or drag with the mouse) to change it. -->
            <article class="slide" id="slide">
                <img class="photo" id="meal-photo" alt="" draggable="false">

                <div class="card">
                    <p class="meta">
                        <span class="meta-time" id="meal-time"></span><span class="meta-dot">·</span><span id="meal-tag"></span><span class="meta-dot">·</span><span id="meal-servings"></span>
                    </p>

                    <button type="button" class="summary" id="open-details" aria-haspopup="dialog">
                        <h2 class="recipe-title" id="meal-title"></h2>
                        <p class="recipe-desc" id="meal-desc"></p>
                    </button>

                    <div class="pantry-pill">
                        <span class="pantry-label">In pantry</span>
                        <span class="pantry-items" id="meal-pantry"></span>
                        <span class="pantry-buy" id="meal-buy"></span>
                    </div>

                    <div class="card-actions">
                        <button type="button" class="action-btn" id="next-btn" aria-label="Next meal">
                            <svg class="icon"><use href="#icon-x"/></svg>
                        </button>
                        <button type="button" class="action-btn like-btn" id="like-btn" aria-pressed="false">
                            <svg class="icon"><use href="#icon-heart"/></svg>
                            <span id="like-label">Like</span>
                        </button>
                        <button type="button" class="action-btn" id="calendar-btn" aria-label="Add to calendar">
                            <svg class="icon"><use href="#icon-calendar-plus"/></svg>
                        </button>
                    </div>
                </div>
            </article>

            <!-- Shown after swiping past the 5th meal -->
            <section class="done" id="done" hidden>
                <div class="done-card">
                    <h2>You're all caught up</h2>
                    <p>That's all 5 of tonight's picks. Check back tomorrow for more.</p>
                    <button type="button" class="action-btn like-btn" id="restart-btn">See them again</button>
                </div>
            </section>

            <div class="top-scrim"></div>

            <header class="app-header">
                <div class="header-row">
                    <h1 class="brand">Meal Planner<span>.</span></h1>
                    <button type="button" class="profile-btn" id="open-profile" aria-label="Logan's kitchen profile and settings" aria-haspopup="dialog" title="Logan's kitchen">
                        LS
                    </button>
                </div>

                <div class="picks-row">
                    <span class="picks-label">Tonight's picks</span>
                    <span class="picks-count" id="picks-count"></span>
                </div>
                <div class="progress" id="progress"></div>
            </header>

            <!-- Previous / next buttons, only shown on computers -->
            <div class="stage-arrows">
                <button type="button" class="arrow-btn" id="prev-arrow" aria-label="Previous meal">
                    <svg class="icon"><use href="#icon-chevron-left"/></svg>
                </button>
                <button type="button" class="arrow-btn" id="next-arrow" aria-label="Next meal">
                    <svg class="icon"><use href="#icon-chevron-right"/></svg>
                </button>
            </div>
        </main>

        <nav class="nav" aria-label="Main">
            <p class="nav-brand">Meal Planner<span>.</span></p>
            <ul>
                <li><a class="nav-link" href="/calendar"><span class="nav-icon"><svg class="icon"><use href="#icon-calendar"/></svg></span>Calendar</a></li>
                <li><a class="nav-link" href="/shopping.html"><span class="nav-icon"><svg class="icon"><use href="#icon-list"/></svg></span>Shopping</a></li>
                <li class="nav-home"><a class="nav-link" href="/" aria-current="page"><span class="nav-icon"><svg class="icon"><use href="#icon-home"/></svg></span>Home</a></li>
                <li><a class="nav-link" href="/search.html"><span class="nav-icon"><svg class="icon"><use href="#icon-search"/></svg></span>Search</a></li>
                <li><a class="nav-link" href="/pantry"><span class="nav-icon"><svg class="icon"><use href="#icon-basket"/></svg></span>Pantry</a></li>
            </ul>
        </nav>
    </div>

    <!-- Recipe details popup. Left blank on purpose: the full details page is being built separately. -->
    <dialog class="details" id="recipe-details" aria-labelledby="details-title">
        <div class="details-header">
            <h2 id="details-title"></h2>
            <button type="button" class="details-close" id="close-details" aria-label="Close">
                <svg class="icon"><use href="#icon-x"/></svg>
            </button>
        </div>
        <div class="details-body" id="details-body">
            <!-- Recipe details go here -->
        </div>
    </dialog>

    <!-- Profile and settings popup. Placeholder data until it loads from the database. -->
    <dialog class="profile" id="profile" aria-labelledby="profile-title">
        <div class="profile-header">
            <button type="button" class="profile-back" id="close-profile" aria-label="Back">
                <svg class="icon"><use href="#icon-chevron-left"/></svg>
            </button>
            <h2 id="profile-title">Profile and Settings</h2>
        </div>

        <div class="profile-body">
            <section class="profile-main">
                <div class="profile-identity">
                    <div class="avatar" aria-hidden="true">LS</div>
                    <div>
                        <p class="profile-name">Logan's kitchen</p>
                        <p class="profile-sub">Cooking for 2 · Denver</p>
                    </div>
                </div>

                <div class="taste-card">
                    <h3 class="taste-title"><svg class="icon"><use href="#icon-user"/></svg>Your taste profile</h3>
                    <p class="taste-text">You lean toward quick, vegetable-forward meals with a little heat.</p>
                </div>
            </section>

            <!-- Settings destinations are wired as they become available. -->
            <ul class="settings-list">
                <li>
                    <a class="settings-row" href="/liked">
                        <span class="settings-icon"><svg class="icon"><use href="#icon-heart"/></svg></span>
                        <span class="settings-text">
                            <span class="settings-title">Liked recipes</span>
                            <span class="settings-desc">Your saved collection</span>
                        </span>
                        <svg class="icon"><use href="#icon-chevron-right"/></svg>
                    </a>
                </li>
                <li>
                    <button type="button" class="settings-row">
                        <span class="settings-icon"><svg class="icon"><use href="#icon-leaf"/></svg></span>
                        <span class="settings-text">
                            <span class="settings-title">Dietary preferences</span>
                            <span class="settings-desc">Vegetarian-friendly</span>
                        </span>
                        <svg class="icon"><use href="#icon-chevron-right"/></svg>
                    </button>
                </li>
                <li>
                    <button type="button" class="settings-row">
                        <span class="settings-icon"><svg class="icon"><use href="#icon-sliders"/></svg></span>
                        <span class="settings-text">
                            <span class="settings-title">Recommendation settings</span>
                            <span class="settings-desc">Balanced variety</span>
                        </span>
                        <svg class="icon"><use href="#icon-chevron-right"/></svg>
                    </button>
                </li>
                <li>
                    <button type="button" class="settings-row">
                        <span class="settings-icon"><svg class="icon"><use href="#icon-bell"/></svg></span>
                        <span class="settings-text">
                            <span class="settings-title">Notifications</span>
                            <span class="settings-desc">Weekly planning reminder</span>
                        </span>
                        <svg class="icon"><use href="#icon-chevron-right"/></svg>
                    </button>
                </li>
            </ul>

            <section class="profile-restrictions">
                <h3 class="section-label">Dietary restrictions</h3>
                <div class="chips">
                    <span class="chip chip-green">Vegetarian meals</span>
                    <span class="chip">No peanuts</span>
                    <!-- TODO: open a picker and save the new restriction -->
                    <button type="button" class="chip chip-add">+ Add preference</button>
                </div>
            </section>
        </div>
    </dialog>

    <script src="/js/index.js" defer></script>
</body>
</html>
