<%
  // Locals:
  //   error  - message shown above the form
  //   values - { email } so the user doesn't retype it
  //   sent   - the form was submitted; show "check your email"
  //   email  - the address that was submitted
  const values = locals.values || {}
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forgot password · Meal Planner</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>
    <main class="auth">
        <section class="auth-card" aria-labelledby="auth-title">
            <p class="brand">Meal Planner<span>.</span></p>

            <% if (locals.sent) { %>
                <h1 class="auth-title" id="auth-title">Check your email</h1>
                <p class="auth-notice" role="status">
                    If <strong><%= email %></strong> has a Meal Planner account, we've sent it a link to reset the password.
                </p>
                <p class="auth-sub">The link expires in 1 hour. If you don't see the email, check your spam folder.</p>

                <form class="auth-form" method="post" action="/forgot-password">
                    <input type="hidden" name="email" value="<%= email %>">
                    <button class="auth-btn auth-btn-secondary" type="submit">Send it again</button>
                </form>
            <% } else { %>
                <h1 class="auth-title" id="auth-title">Forgot your password?</h1>
                <p class="auth-sub">Enter the email you log in with and we'll send you a link to choose a new password.</p>

                <% if (locals.error) { %>
                    <p class="auth-error" role="alert"><%= error %></p>
                <% } %>

                <form class="auth-form" method="post" action="/forgot-password" novalidate>
                    <div class="field">
                        <label for="email">Email</label>
                        <input id="email" name="email" type="email" autocomplete="email" required
                               value="<%= values.email || '' %>">
                    </div>
                    <button class="auth-btn" type="submit">Send reset link</button>
                </form>
            <% } %>

            <p class="auth-switch">Remembered it? <a href="/login">Log in</a></p>
        </section>
    </main>
</body>
</html>
