<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Pantry | Preply</title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/pantry.css">
  <link rel="stylesheet" href="/css/page-card.css">
  <link rel="stylesheet" href="/css/profile-menu.css">
  <link rel="stylesheet" href="/css/page-header.css">
  <link rel="stylesheet" href="/css/site-nav.css">
    <script src="/js/no-back-cache.js"></script>
</head>
<body class="has-site-nav">

<%- include('partials/page-header', { pageTitle: 'Pantry' }) %>

<div class="laptop page-card">

  <section class="pantry-hero" aria-labelledby="pantry-title">
    <img
      src="/images/pantry-banner.jpeg"
      alt="Pasta, tomatoes, lemons, basil, olive oil, and garlic arranged on a kitchen counter"
    >
    <div class="pantry-hero-title">
      <div class="eyebrow">Pantry</div>
      <h1 id="pantry-title">Virtual pantry</h1>
    </div>
  </section>

  <main>
    <section>
      <p class="lede">Keep a lightweight record of what is already at home, so your shopping list only shows what you actually need.</p>

      <div class="summary">
        <div class="eyebrow">At home</div>
        <div class="count"><strong id="total"><%= items.length %></strong><span>ingredients</span></div>
        <div class="legend">
          <span class="chip plenty" id="legend-plenty">Plenty left</span>
          <span class="chip low" id="legend-low">Running low</span>
          <span class="chip none" id="legend-none">None</span>
        </div>
      </div>

      <label class="field search">
        <svg viewBox="0 0 24 24"><circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5"/></svg>
        <input id="search" type="search" placeholder="Search your pantry" aria-label="Search your pantry" autocomplete="off">
      </label>

      <%# Narrows the list to one amount; works together with the search (js/pantry.js) %>
      <div class="amount-filter" id="amount-filter" role="group" aria-label="Filter your pantry by amount">
        <button class="amount-filter-btn" type="button" data-amount="" aria-pressed="true">All</button>
        <button class="amount-filter-btn" type="button" data-amount="0" aria-pressed="false">Plenty left</button>
        <button class="amount-filter-btn" type="button" data-amount="1" aria-pressed="false">Running low</button>
        <button class="amount-filter-btn" type="button" data-amount="2" aria-pressed="false">None</button>
      </div>

      <form class="add-row" id="add-form">
        <label class="field add-name-field">
          <input id="add-input" type="text" placeholder="Add an item" aria-label="Ingredient name" autocomplete="off" required>
        </label>
        <button class="btn" type="submit">
          <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>Add
        </button>
      </form>
      <p class="feedback" id="feedback" role="status" aria-live="polite" hidden></p>
    </section>

    <section>
      <%# One Edit button for the whole list. In edit mode (js/pantry.js) every
          amount can be changed and ingredients can be ticked to change or
          delete several at once; nothing is saved until Save changes. %>
      <div class="edit-tools" id="edit-tools">
        <div class="list-head">
          <h2>Your ingredients</h2>
          <div class="list-actions">
            <button class="item-action" type="button" id="edit-start">Edit</button>
            <button class="item-action" type="button" id="edit-cancel" hidden>Cancel</button>
            <button class="item-action save-action" type="button" id="edit-save" hidden>Save changes</button>
          </div>
        </div>

        <div class="edit-bar" id="edit-bar" hidden>
          <label class="select-all">
            <input type="checkbox" id="select-all">
            <span id="selected-count">Select all</span>
          </label>
          <div class="edit-bar-actions" role="group" aria-label="Change the selected ingredients">
            <span class="edit-bar-label">Set to</span>
            <button class="chip plenty" type="button" data-set-status="0">Plenty left</button>
            <button class="chip low" type="button" data-set-status="1">Running low</button>
            <button class="chip none" type="button" data-set-status="2">None</button>
            <button class="item-action delete-action" type="button" id="delete-selected">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>Delete
            </button>
          </div>
        </div>
        <p class="edit-status" id="edit-status" role="status" aria-live="polite" hidden></p>
      </div>

      <div class="grid" id="grid">
        <% items.forEach(item => { %>
          <%- include('partials/item', { item, statuses }) %>
        <% }) %>
      </div>
      <div class="empty" id="empty" hidden></div>

      <%# Blueprint cloned by the client script after the server creates an item %>
      <template id="item-template">
        <%- include('partials/item', { item: { ingredient_id: 0, pantry_amount_id: 0, name: '__NAME__', status: 'plenty' }, statuses }) %>
      </template>
    </section>
  </main>
</div>

<%# "Are you sure?" before Save changes deletes anything (js/pantry.js fills it in) %>
<dialog class="confirm-remove" id="confirm-remove" aria-labelledby="confirm-remove-title" aria-describedby="confirm-remove-text">
  <form method="dialog">
    <div class="confirm-remove-icon" aria-hidden="true">
      <svg viewBox="0 0 24 24"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
    </div>
    <h2 id="confirm-remove-title"></h2>
    <p id="confirm-remove-text"></p>
    <ul class="confirm-remove-list" id="confirm-remove-list"></ul>
    <div class="confirm-remove-actions">
      <button class="item-action" type="submit" value="cancel" autofocus>Keep them</button>
      <button class="item-action save-action" type="submit" value="delete" id="confirm-remove-yes"></button>
    </div>
  </form>
</dialog>

<%- include('partials/site-nav') %>
<%- include('partials/profile-menu') %>
<script src="/js/profile-menu.js" defer></script>
<script src="/js/pantry.js" defer></script>
</body>
</html>
