<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title><%= recipe ? recipe.title : 'Recipe not found' %> | Preply</title>
<link rel="icon" type="image/svg+xml" href="/images/logo.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
<%# recipe-page.css has this page's colors and layout; plan-dialog.css styles the Add to meal plan popup %>
<link rel="stylesheet" href="/css/recipe-page.css">
<link rel="stylesheet" href="/css/plan-dialog.css">
<link rel="stylesheet" href="/css/star-rating.css">
<link rel="stylesheet" href="/css/page-card.css">
<link rel="stylesheet" href="/css/profile-menu.css">
<link rel="stylesheet" href="/css/page-header.css">
<link rel="stylesheet" href="/css/site-nav.css">
<script src="/js/no-back-cache.js"></script>
</head>
<body class="has-site-nav">

<svg width="0" height="0" style="position: absolute" aria-hidden="true">
  <symbol id="icon-chevron-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
  <symbol id="icon-heart" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></symbol>
  <symbol id="icon-calendar-plus" viewBox="0 0 24 24"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8"/><path d="M3 10h18"/><path d="M16 19h6"/><path d="M19 16v6"/></symbol>
</svg>

<%- include('partials/page-header', { pageTitle: 'Recipes' }) %>

<%# One recipe on its own page (GET /recipes/:id in back/src/routes/search.js,
    shaped by back/src/recipeView.js). js/recipe-page.js runs Like and
    Add to meal plan; js/star-rating.js runs the stars. %>
<div class="recipe-page page-card">
  <a class="recipe-back" href="<%= back.href %>">
    <svg class="icon" aria-hidden="true"><use href="#icon-chevron-left"/></svg>
    <%= back.label %>
  </a>

  <% if (!recipe) { %>
  <section class="recipe-missing">
    <h1>This recipe isn't available</h1>
    <p>It may have been removed, or the link is wrong.</p>
    <a class="recipe-btn recipe-primary" href="/recipes">Browse recipes</a>
  </section>
  <% } else { %>

  <%# Coming from the meal plan's + (via Recipes): Add to meal plan starts on
      that day and meal. js/plan-dialog.js reads this. %>
  <% if (plan) { %><div id="plan-banner" data-date="<%= plan.date %>" data-slot="<%= plan.slot || '' %>" hidden></div><% } %>

  <article class="recipe" id="recipe" data-recipe-id="<%= recipe.recipe_id %>" data-recipe-title="<%= recipe.title %>" data-meal-type="<%= recipe.mealType || '' %>">
    <header class="recipe-hero">
      <div class="recipe-hero-text">
        <% if (recipe.mealType) { %><p class="recipe-eyebrow"><%= recipe.mealType %></p><% } %>
        <h1><%= recipe.title %></h1>
        <% if (recipe.facts.length) { %>
        <ul class="recipe-facts">
          <% recipe.facts.forEach(function (fact) { %><li><%= fact %></li><% }); %>
        </ul>
        <% } %>
        <div class="recipe-rating">
          <span class="recipe-rating-label">Your rating</span>
          <%- include('partials/star-rating', { recipeId: recipe.recipe_id, title: recipe.title, myRating: recipe.rating.myRating, average: recipe.rating.average, count: recipe.rating.count, canRate: recipe.rating.canRate, rateFrom: recipe.rating.rateFrom }) %>
        </div>
        <div class="recipe-actions">
          <button type="button" class="recipe-btn recipe-primary" id="recipe-plan">
            <svg class="icon" aria-hidden="true"><use href="#icon-calendar-plus"/></svg>
            Add to meal plan
          </button>
          <button type="button" class="recipe-btn recipe-like" id="recipe-like" aria-pressed="<%= recipe.liked %>"
            title="<%= recipe.liked ? 'Remove from your liked recipes' : 'Add to your liked recipes' %>">
            <svg class="icon" aria-hidden="true"><use href="#icon-heart"/></svg>
            <span id="recipe-like-text"><%= recipe.liked ? 'Liked' : 'Like' %></span>
          </button>
        </div>
      </div>

      <% if (recipe.macroTiles.length) { %>
      <section class="recipe-macros" aria-label="Macros per serving">
        <% recipe.macroTiles.forEach(function (tile) { %>
        <div><strong><%= tile.value %></strong><span><%= tile.label %></span></div>
        <% }); %>
        <p class="recipe-macros-note">Per serving</p>
      </section>
      <% } %>
    </header>

    <% if (recipe.macrosText) { %><p class="recipe-macros-text"><%= recipe.macrosText %></p><% } %>

    <div class="recipe-columns">
      <section class="recipe-panel recipe-ingredients" aria-labelledby="ingredients-title">
        <div class="recipe-panel-heading">
          <h2 id="ingredients-title">Ingredients</h2>
          <% if (recipe.pantrySummary) { %><span><%= recipe.pantrySummary %></span><% } %>
        </div>
        <% if (recipe.ingredients.length) { %>
        <ul>
          <% recipe.ingredients.forEach(function (item) { %>
          <li>
            <span class="recipe-amount"><%= item.amount %></span>
            <span class="recipe-ingredient-name"><%= item.name %></span>
            <span class="recipe-pantry <%= item.pantry.className %>"><%= item.pantry.label %></span>
          </li>
          <% }); %>
        </ul>
        <% } else { %>
        <p class="recipe-empty">No ingredients are listed for this recipe yet.</p>
        <% } %>
      </section>

      <section class="recipe-panel recipe-steps" aria-labelledby="steps-title">
        <div class="recipe-panel-heading">
          <h2 id="steps-title">Directions</h2>
          <% if (recipe.steps.length) { %><span><%= recipe.steps.length %> <%= recipe.steps.length === 1 ? 'step' : 'steps' %></span><% } %>
          <%# Stops the screen turning off while cooking (js/recipe-page.js).
              Stays hidden in browsers that can't do it. %>
          <button type="button" class="recipe-wake" id="recipe-wake" role="switch" aria-checked="false" hidden>
            <span class="recipe-wake-track" aria-hidden="true"><span class="recipe-wake-thumb"></span></span>
            <span id="recipe-wake-text">Keep screen on</span>
          </button>
        </div>
        <p class="recipe-wake-note" id="recipe-wake-note" role="status" hidden></p>
        <% if (recipe.steps.length) { %>
        <ol>
          <% recipe.steps.forEach(function (step) { %><li><%= step %></li><% }); %>
        </ol>
        <% } else { %>
        <p class="recipe-empty">No directions are listed for this recipe yet.</p>
        <% } %>
      </section>
    </div>

    <% if (recipe.addedBy) { %><p class="recipe-added-by">Added by <%= recipe.addedBy %></p><% } %>
  </article>
  <% } %>
</div>

<%- include('partials/site-nav') %>
<%- include('partials/profile-menu') %>
<% if (recipe) { %><%- include('partials/plan-dialog') %><% } %>
<script src="/js/events.js" defer></script>
<script src="/js/profile-menu.js" defer></script>
<% if (recipe) { %>
<script src="/js/plan-dialog.js" defer></script>
<script src="/js/recipe-page.js" defer></script>
<script src="/js/star-rating.js" defer></script>
<% } %>
</body>
</html>
