<%
  // For a logged-in user (GET/POST /account/password).
  // Locals:
  //   error  - message shown above the form
  //   notice - the password was changed
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Change password · Meal Planner</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/auth.css">
    <script src="/js/no-back-cache.js"></script>
</head>

<body>
    <main class="auth">
        <section class="auth-card" aria-labelledby="auth-title">
            <p class="brand">Meal Planner<span>.</span></p>
            <h1 class="auth-title" id="auth-title">Change password</h1>
            <p class="auth-sub">Signed in as <strong><%= currentUser.email %></strong>.</p>

            <% if (locals.notice) { %>
                <p class="auth-notice" role="status"><%= notice %></p>
                <a class="auth-btn auth-btn-link" href="/home">Back to Meal Planner</a>
            <% } else { %>
                <% if (locals.error) { %>
                    <p class="auth-error" role="alert"><%= error %></p>
                <% } %>

                <form class="auth-form" method="post" action="/account/password" novalidate>
                    <div class="field">
                        <div class="field-label-row">
                            <label for="current_password">Current password</label>
                            <a class="field-link" href="/forgot-password">Forgot it?</a>
                        </div>
                        <input id="current_password" name="current_password" type="password" autocomplete="current-password" required>
                    </div>

                    <div class="field">
                        <label for="password">New password</label>
                        <input id="password" name="password" type="password" autocomplete="new-password"
                               minlength="8" maxlength="72" required aria-describedby="password-hint">
                        <p class="hint" id="password-hint">8 to 72 characters. You'll be logged out on other devices.</p>
                    </div>

                    <div class="field">
                        <label for="confirm_password">Confirm new password</label>
                        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required>
                    </div>

                    <button class="auth-btn" type="submit">Change password</button>
                </form>

                <p class="auth-switch"><a href="/home">Cancel</a></p>
            <% } %>
        </section>
    </main>
</body>
</html>
