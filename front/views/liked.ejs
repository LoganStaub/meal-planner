<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title><%= title %> | Preply</title>
<link rel="icon" type="image/svg+xml" href="/images/logo.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/liked.css">
<link rel="stylesheet" href="/css/star-rating.css">
<link rel="stylesheet" href="/css/page-card.css">
<link rel="stylesheet" href="/css/profile-menu.css">
<link rel="stylesheet" href="/css/page-header.css">
<link rel="stylesheet" href="/css/site-nav.css">
<script src="/js/no-back-cache.js"></script>
</head>
<body class="has-site-nav">

<!-- Reusable SVG symbols -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true">
  <symbol id="ph" viewBox="0 0 24 24"><rect x="3" y="4" width="18" height="16" rx="2"/><circle cx="9" cy="10" r="1.8"/><path d="M21 16l-5-5-8 9"/></symbol>
  <symbol id="heart" viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.6-9.2C.9 8.4 3 5 6.4 5c2 0 3.6 1.1 4.6 2.7C12 6.1 13.6 5 15.6 5 19 5 21.1 8.4 19.6 11.8 19.5 11.8 12 21 12 21z"/></symbol>
  <symbol id="check" viewBox="0 0 24 24"><path d="M5 12l5 5L20 7"/></symbol>
</svg>

<%- include('partials/page-header', { pageTitle: title }) %>

<div class="app page-card">


  <header class="hero">
    <div class="hero-text">
      <div class="eyebrow">Your collection</div>
      <h1><%= title %></h1>
      <p>Your saved dishes, ready when you are.</p>
    </div>
    <div class="saved-pill" data-tour="liked-count"><svg><use href="#heart"/></svg> <%= recipes.length %> saved</div>
  </header>

  <main class="grid">
    <% if (recipes.length === 0) { %>
    <section class="empty-state">
      <h2>No saved recipes yet</h2>
      <p>Like a recipe from Home and it will be waiting here.</p>
    </section>
    <% } %>
    <% recipes.forEach(function (r) { %>
    <%# A small preview: the whole card opens the recipe page (the title's
        link stretches over it); the stars stay clickable on top. %>
    <article class="card">
      <div class="thumb">
        <%# The recipe's photo (recipes.image_path, same as Home and Recipes).
            The placeholder sits underneath and shows if there's none or it fails to load. %>
        <svg class="placeholder" aria-hidden="true"><use href="#ph"/></svg>
        <% if (r.image) { %>
          <img src="<%= r.image %>" alt="" loading="lazy" onerror="this.remove()">
        <% } %>
        <span class="heart" aria-hidden="true"><svg><use href="#heart"/></svg></span>
      </div>
      <div class="card-body">
        <div class="tags"><% if (r.time) { %><span class="time"><%= r.time %> min</span><% } %><span class="diet"><%= r.tag %></span></div>
        <h3><a class="card-link" href="/recipes/<%= r.recipe_id %>"><%= r.title %></a></h3>
        <%- include('partials/star-rating', { recipeId: r.recipe_id, title: r.title, myRating: r.myRating, average: r.ratingAverage, count: r.ratingCount, canRate: r.can_rate, rateFrom: r.rate_from }) %>
      </div>
      <div class="card-foot">
        <span class="pantry"><svg viewBox="0 0 24 24"><use href="#check"/></svg><%= r.inPantry %> in pantry</span>
        <% if (r.toBuy > 0) { %><span class="buy">+<%= r.toBuy %> to buy</span><% } else { %><span class="buy all">Have it all</span><% } %>
      </div>
    </article>
    <% }); %>
  </main>
</div>

<%- include('partials/site-nav') %>
<%- include('partials/profile-menu') %>
<script src="/js/profile-menu.js" defer></script>
<script src="/js/star-rating.js" defer></script>
</body>
</html>
