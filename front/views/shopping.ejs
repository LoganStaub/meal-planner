<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Shopping | Meal Planner</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
  <%# pantry.css has the shared reset and body styles; shopping.css adds this page's parts %>
  <link rel="stylesheet" href="/css/pantry.css">
  <link rel="stylesheet" href="/css/profile-menu.css">
  <link rel="stylesheet" href="/css/page-header.css">
  <link rel="stylesheet" href="/css/site-nav.css">
  <link rel="stylesheet" href="/css/shopping.css">
  <script src="/js/no-back-cache.js"></script>
</head>
<body class="has-site-nav">
  <%- include('partials/page-header', { pageTitle: 'Shopping' }) %>

  <main class="shopping">
    <%# Phones: one column. Computers: summary and add box on the left, list on the right. %>
    <div class="shop-layout">
      <div class="shop-side">
        <section class="shop-week">
          <p class="shop-week-label">This week</p>
          <p class="shop-week-count" id="items-left-text"><%= items.length %> <%= items.length === 1 ? 'item' : 'items' %> left</p>
        </section>

        <form class="shop-add" id="add-form" autocomplete="off">
          <input type="text" id="add-input" placeholder="Add something else" aria-label="Add an item">
          <button class="shop-add-btn" type="submit" aria-label="Add item">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          </button>
        </form>
      </div>

      <section class="shop-list-section" aria-labelledby="shop-list-heading">
        <h2 class="shop-list-heading" id="shop-list-heading">Your list</h2>
        <ul class="shop-list" id="item-list">
          <% items.forEach(item => { %>
            <li class="shop-item">
              <input type="checkbox" class="shop-check" aria-label="Got <%= item.name %>">
              <div class="shop-text">
                <span class="shop-name"><%= item.name %></span>
                <% if (item.forRecipe) { %>
                  <span class="shop-for">For <%= item.forRecipe %></span>
                <% } %>
              </div>
              <span class="shop-amount"><%= item.amount %></span>
            </li>
          <% }) %>
        </ul>
      </section>
    </div>
  </main>

  <%- include('partials/site-nav') %>
  <%- include('partials/profile-menu') %>
  <script src="/js/profile-menu.js" defer></script>
  <script src="/js/shopping.js" defer></script>
</body>
</html>
