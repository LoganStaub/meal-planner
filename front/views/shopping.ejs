<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <title>Shopping | Preply</title>
  <link rel="icon" type="image/svg+xml" href="/images/logo.svg">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
  <%# pantry.css has the shared reset and body styles; shopping.css adds this page's parts %>
  <link rel="stylesheet" href="/css/pantry.css">
  <link rel="stylesheet" href="/css/profile-menu.css">
  <link rel="stylesheet" href="/css/page-header.css">
  <link rel="stylesheet" href="/css/site-nav.css">
  <link rel="stylesheet" href="/css/shopping.css">
  <script src="/js/no-back-cache.js"></script>
</head>
<body class="has-site-nav">
  <%- include('partials/page-header', { pageTitle: 'Shopping' }) %>

  <main class="shopping">
    <%# Phones: one column. Computers: summary and add box on the left, list on the right. %>
    <div class="shop-layout">
      <div class="shop-side">
        <section class="shop-week">
          <p class="shop-week-label">Next 7 days</p>
          <p class="shop-week-count" id="items-left-text"><%= items.length %> <%= items.length === 1 ? 'item' : 'items' %> left</p>
        </section>

        <form class="shop-add" id="add-form" autocomplete="off">
          <input type="text" id="add-input" placeholder="Add something else" aria-label="Add an item">
          <button class="shop-add-btn" type="submit" aria-label="Add item">
            <svg viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
          </button>
        </form>
      </div>

      <section class="shop-list-section" aria-labelledby="shop-list-heading" data-tour="shopping-list">
        <%# Edit: tick items and Remove them, after an "are you sure?" (js/shopping.js).
            The buttons, bar and popup reuse the Pantry's styles from pantry.css. %>
        <div class="shop-list-head">
          <h2 class="shop-list-heading" id="shop-list-heading">Your list</h2>
          <button class="item-action edit-start" type="button" id="edit-start"<%= items.length ? '' : ' disabled' %>>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 20h9"/><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"/></svg>Edit
          </button>
          <button class="item-action save-action" type="button" id="edit-done" hidden>Done</button>
        </div>
        <div class="edit-bar shop-edit-bar" id="edit-bar" hidden>
          <label class="select-all">
            <input type="checkbox" id="select-all">
            <span id="selected-count">Select all</span>
          </label>
          <button class="item-action delete-action" type="button" id="remove-selected" disabled>
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>Remove
          </button>
        </div>
        <%# Ticking an item saves it to your pantry (see routes/shopping.js) %>
        <ul class="shop-list" id="item-list">
          <% items.forEach(item => { %>
            <li class="shop-item" data-ingredient-id="<%= item.ingredient_id %>">
              <input type="checkbox" class="item-select shop-select" aria-label="Select <%= item.name %>" hidden>
              <input type="checkbox" class="shop-check" aria-label="Got <%= item.name %>">
              <div class="shop-text">
                <span class="shop-name"><%= item.name %></span>
                <% if (item.forRecipe) { %>
                  <span class="shop-for">For <%= item.forRecipe %></span>
                <% } %>
              </div>
              <% if (item.amount) { %>
                <span class="shop-amount"><%= item.amount %></span>
              <% } %>
            </li>
          <% }) %>
        </ul>
        <p class="shop-note" id="empty-note"<%= items.length ? ' hidden' : '' %>>Nothing to buy. Add some meals to your meal plan and your list will fill in.</p>
        <p class="shop-note error" id="error-note" hidden></p>
      </section>
    </div>
  </main>

  <%# "Are you sure?" before removing items (js/shopping.js fills it in; styles from pantry.css) %>
  <dialog class="confirm-remove" id="confirm-remove" aria-labelledby="confirm-remove-title" aria-describedby="confirm-remove-text">
    <form method="dialog">
      <div class="confirm-remove-icon" aria-hidden="true">
        <svg viewBox="0 0 24 24"><path d="M4 7h16M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3"/></svg>
      </div>
      <h2 id="confirm-remove-title"></h2>
      <p id="confirm-remove-text"></p>
      <ul class="confirm-remove-list" id="confirm-remove-list"></ul>
      <div class="confirm-remove-actions">
        <button class="item-action" type="submit" value="cancel" autofocus>Keep them</button>
        <button class="item-action save-action" type="submit" value="remove" id="confirm-remove-yes"></button>
      </div>
    </form>
  </dialog>

  <%- include('partials/site-nav') %>
  <%- include('partials/profile-menu') %>
  <script src="/js/profile-menu.js" defer></script>
  <script src="/js/shopping.js" defer></script>
</body>
</html>