<%# Profile menu for every page except home (home has its own profile popup in index.ejs). Only working links. %>
<aside class="profile-menu" id="profile-menu" role="dialog" aria-labelledby="profile-menu-title" hidden>
  <div class="profile-menu-heading">
    <h2 id="profile-menu-title">Profile and settings</h2>
    <button class="profile-menu-close" id="profile-menu-close" type="button" aria-label="Close profile settings">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m18 6-12 12M6 6l12 12"/></svg>
    </button>
  </div>

  <div class="profile-menu-identity">
    <div class="profile-menu-avatar" aria-hidden="true" style="<%= currentUser.avatar_style %>">
      <% if (currentUser.profile_pic) { %><img src="<%= currentUser.profile_pic %>" alt=""><% } else { %><%= currentUser.initials %><% } %>
    </div>
    <div>
      <p class="profile-menu-name"><%= currentUser.display_name %></p>
      <p class="profile-menu-subtitle"><%= currentUser.email %><% if (currentUser.is_admin) { %> · Admin<% } %></p>
    </div>
  </div>

  <ul class="profile-menu-settings">
    <li>
      <a class="profile-menu-row" href="/liked">
        <span class="profile-menu-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21l7.8-7.5 1.1-1.1a5.5 5.5 0 0 0-.1-7.8Z"/></svg></span>
        <span class="profile-menu-copy"><strong>Liked recipes</strong><small>Your saved collection</small></span>
        <svg class="profile-menu-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </li>
    <li>
      <a class="profile-menu-row" href="/account/password">
        <span class="profile-menu-icon" aria-hidden="true"><svg viewBox="0 0 24 24"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg></span>
        <span class="profile-menu-copy"><strong>Change password</strong><small>Update your login password</small></span>
        <svg class="profile-menu-chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg>
      </a>
    </li>
  </ul>

  <form class="profile-menu-logout" method="post" action="/logout">
    <button type="submit">Log out</button>
  </form>
</aside>
