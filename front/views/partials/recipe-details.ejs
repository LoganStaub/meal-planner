<%# The recipe window and the "Add to calendar" popup, shared by the Home and
    Recipes pages. A page that includes this also needs css/recipe-details.css
    and js/recipe-details.js.

    To open the window from a page:
      - give a link data-recipe-details="<recipe id>", or
      - call RecipeDetails.open(recipeId, { title }) from a script. %>

<%# Its own icons, so it works whatever icon set the page has %>
<svg width="0" height="0" style="position: absolute" aria-hidden="true">
    <symbol id="rd-icon-x" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></symbol>
    <symbol id="rd-icon-heart" viewBox="0 0 24 24"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></symbol>
    <symbol id="rd-icon-calendar-plus" viewBox="0 0 24 24"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M21 13V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h8"/><path d="M3 10h18"/><path d="M16 19h6"/><path d="M19 16v6"/></symbol>
    <symbol id="rd-icon-calendar" viewBox="0 0 24 24"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></symbol>
</svg>

<%# The recipe window. js/recipe-details.js loads the recipe from
    /api/recipes/:id and fills in #details-body. %>
<dialog class="details recipe-window" id="recipe-details" aria-labelledby="details-title">
    <div class="details-header">
        <h2 id="details-title"></h2>
        <button type="button" class="details-close" id="close-details" aria-label="Close">
            <svg class="icon"><use href="#rd-icon-x"/></svg>
        </button>
    </div>

    <div class="details-body" id="details-body"></div>

    <%# Same pair as the home page card: the main button and the heart %>
    <div class="rw-actions" id="details-actions" hidden>
        <button type="button" class="rw-btn rw-primary" id="details-calendar">
            <svg class="icon"><use href="#rd-icon-calendar-plus"/></svg>
            <span>Add to calendar</span>
        </button>
        <button type="button" class="rw-btn rw-like" id="details-like" aria-pressed="false">
            <svg class="icon"><use href="#rd-icon-heart"/></svg>
            <span id="details-like-text">Like</span>
        </button>
    </div>
</dialog>

<%# "Add to calendar" popup: pick a day and a meal, then save to /api/me/calendar %>
<dialog class="details plan" id="plan-dialog" aria-labelledby="plan-heading">
    <form class="plan-form" id="plan-form" novalidate>
        <div class="details-header">
            <div>
                <h2 id="plan-heading">Add to calendar</h2>
                <p class="plan-recipe" id="plan-recipe"></p>
            </div>
            <button type="button" class="details-close" data-plan-close aria-label="Close">
                <svg class="icon"><use href="#rd-icon-x"/></svg>
            </button>
        </div>

        <div class="plan-body" id="plan-choose">
            <label class="plan-label" for="plan-date">Day</label>
            <input class="plan-date" type="date" id="plan-date" required>

            <fieldset class="plan-meals">
                <legend class="plan-label">Meal</legend>
                <% [['1', 'Breakfast'], ['2', 'Lunch'], ['3', 'Dinner'], ['4', 'Snack'], ['5', 'Dessert']].forEach(function (slot) { %>
                <label class="plan-meal">
                    <input type="radio" name="meal_slot" value="<%= slot[0] %>">
                    <span><%= slot[1] %></span>
                </label>
                <% }); %>
            </fieldset>

            <p class="plan-message" id="plan-message" role="alert" hidden></p>

            <div class="plan-actions">
                <button type="button" class="plan-btn" data-plan-close>Cancel</button>
                <button type="submit" class="plan-btn plan-primary" id="plan-submit">Add to calendar</button>
            </div>
        </div>

        <div class="plan-body plan-done" id="plan-done" hidden>
            <div class="plan-done-icon" aria-hidden="true">
                <svg class="icon"><use href="#rd-icon-calendar"/></svg>
            </div>
            <p id="plan-done-text" role="status"></p>
            <div class="plan-actions">
                <button type="button" class="plan-btn" data-plan-close>Keep browsing</button>
                <a class="plan-btn plan-primary" id="plan-done-link" href="/calendar">See calendar</a>
            </div>
        </div>
    </form>
</dialog>
