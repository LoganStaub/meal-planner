<%# One pantry ingredient. The tick box, the clickable amount and "Will be
    removed" only come into play in edit mode (js/pantry.js). %>
<% const displayName = item.name.toLocaleLowerCase().replace(/(^|[\s-])([\p{L}\p{N}])/gu, (_, separator, letter) => separator + letter.toLocaleUpperCase()); %>
<div class="item" data-ingredient-id="<%= item.ingredient_id %>" data-pantry-amount-id="<%= item.pantry_amount_id %>" data-name="<%= item.name.toLocaleLowerCase() %>">
  <input class="item-select" type="checkbox" aria-label="Select <%= displayName %>" hidden>
  <span class="item-name"><%= displayName %></span>
  <div class="item-right">
    <span class="item-removing" hidden>Will be removed <button class="item-undo" type="button">Undo</button></span>
    <button class="chip <%= item.status %>" type="button" data-status="<%= item.status %>" aria-label="<%= displayName %>: <%= statuses[item.status].label %>" disabled><%= statuses[item.status].label %></button>
  </div>
</div>
