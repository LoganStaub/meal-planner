<%
  const links = [
    { key: 'calendar', label: 'Calendar', href: '/calendar',
      icon: '<rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/>' },
    { key: 'shopping', label: 'Shopping', href: '#',
      icon: '<path d="M9 6h12M9 12h12M9 18h12M3.5 6l1 1 2-2M3.5 12l1 1 2-2M3.5 18l1 1 2-2"/>' },
    { key: 'home', label: 'Home', href: '/',
      icon: '<path d="M3 11l9-8 9 8v10H3z"/><path d="M9 21v-6h6v6"/>' },
    { key: 'search', label: 'Search', href: '#',
      icon: '<circle cx="11" cy="11" r="7"/><path d="M21 21l-4.5-4.5"/>' },
    { key: 'pantry', label: 'Pantry', href: '/pantry',
      icon: '<path d="M5 10h14l-1.5 9a2 2 0 0 1-2 1.5h-7a2 2 0 0 1-2-1.5z"/><path d="M8 10l3-6M16 10l-3-6"/>' },
  ];
%>
<header>
  <div class="brand">
    <div class="brand-logo">
      <svg viewBox="0 0 24 24"><path d="M7 20h10M8 20v-5a4 4 0 1 1 8 0v5"/><path d="M12 5V3"/></svg>
    </div>
    Mealio
  </div>

  <nav>
    <% links.forEach(link => { %>
      <a href="<%= link.href %>"<%- locals.active === link.key ? ' class="active"' : '' %>>
        <svg viewBox="0 0 24 24"><%- link.icon %></svg><%= link.label %>
      </a>
    <% }) %>
  </nav>

  <button class="avatar profile-trigger" id="profile-trigger" type="button" aria-label="Logan's kitchen profile and settings" aria-controls="profile-menu" aria-expanded="false" title="Logan's kitchen">
    LS
  </button>
</header>