<%
  // Locals the route can pass when re-rendering after a failed POST:
  //   error  - message shown above the form
  //   values - { email } so the user doesn't retype it
  //   next   - page to open after logging in (e.g. /calendar)
  const values = locals.values || {}
%>
<!DOCTYPE html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Log in', styles: ['auth'] }) %>
</head>

<body>
    <main class="auth">
        <section class="auth-card" aria-labelledby="auth-title">
            <p class="brand"><img class="brand-logo" src="<%= asset('/images/logo.svg') %>" alt="" width="28" height="28">Preply<span>.</span></p>
            <h1 class="auth-title" id="auth-title">Welcome back</h1>
            <p class="auth-sub">Log in to see tonight's picks.</p>

            <% if (locals.error) { %>
                <p class="auth-error" role="alert"><%= error %></p>
            <% } %>


            <form class="auth-form" method="post" action="/login" novalidate>
                <% if (locals.next) { %>
                    <input type="hidden" name="next" value="<%= next %>">
                <% } %>
                <div class="field">
                    <label for="email">Email</label>
                    <input id="email" name="email" type="email" autocomplete="email" required
                           value="<%= values.email || '' %>">
                </div>

                <div class="field">
                    <div class="field-label-row">
                        <label for="password">Password</label>
                        <%# No "Forgot password?" link: the app doesn't send email yet. An admin
                            sets a new one with npm run user:password (see the README). %>
                    </div>
                    <input id="password" name="password" type="password" autocomplete="current-password" required>
                </div>

                <button class="auth-btn" type="submit">Log in</button>
            </form>

            <p class="auth-switch">New here? <a href="/signup">Create an account</a></p>
        </section>
    </main>
</body>
</html>
