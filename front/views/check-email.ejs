<%
  // Shown after signup and after asking for a new verification email.
  // Locals:
  //   email      - the address the link was sent to
  //   resent     - true after "Resend email" (the wording stays vague on purpose,
  //                so the page doesn't reveal whether that email has an account)
  //   sendFailed - true if the email couldn't be sent at signup
  const email = locals.email || ''
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Check your email · Meal Planner</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>
    <main class="auth">
        <section class="auth-card" aria-labelledby="auth-title">
            <p class="brand">Meal Planner<span>.</span></p>
            <h1 class="auth-title" id="auth-title">Check your email</h1>

            <% if (locals.sendFailed) { %>
                <p class="auth-error" role="alert">
                    Your account was created, but we couldn't send the verification email. Try sending it again below.
                </p>
            <% } else if (locals.resent) { %>
                <p class="auth-notice" role="status">
                    If <strong><%= email %></strong> has an account that still needs verifying, we've sent a new link.
                </p>
            <% } else { %>
                <p class="auth-sub">
                    We sent a link to <strong><%= email %></strong>. Click it to verify your email and finish creating your account.
                </p>
            <% } %>

            <p class="auth-sub">The link expires in 24 hours. If you don't see the email, check your spam folder.</p>

            <form class="auth-form" method="post" action="/resend-verification">
                <input type="hidden" name="email" value="<%= email %>">
                <button class="auth-btn auth-btn-secondary" type="submit">Resend email</button>
            </form>

            <p class="auth-switch">Already verified? <a href="/login">Log in</a></p>
        </section>
    </main>
</body>
</html>
