<%
  // Opened from the link in the password reset email.
  // Locals:
  //   token   - a valid link: show the new-password form
  //   error   - message shown above the form
  //   invalid - the link is wrong, already used, or expired
%>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reset password | Preply</title>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/auth.css">
</head>

<body>
    <main class="auth">
        <section class="auth-card" aria-labelledby="auth-title">
            <p class="brand"><img class="brand-logo" src="/images/logo.svg" alt="" width="28" height="28">Preply<span>.</span></p>

            <% if (locals.invalid) { %>
                <h1 class="auth-title" id="auth-title">This link doesn't work</h1>
                <p class="auth-sub">
                    It may have expired, already been used, or been replaced by a newer email.
                    Ask for a new link and use the most recent email.
                </p>
                <a class="auth-btn auth-btn-link" href="/forgot-password">Send a new link</a>
            <% } else { %>
                <h1 class="auth-title" id="auth-title">Choose a new password</h1>
                <p class="auth-sub">After this, you'll be logged out on every other device.</p>

                <% if (locals.error) { %>
                    <p class="auth-error" role="alert"><%= error %></p>
                <% } %>

                <form class="auth-form" method="post" action="/reset-password" novalidate>
                    <input type="hidden" name="token" value="<%= token %>">

                    <div class="field">
                        <label for="password">New password</label>
                        <input id="password" name="password" type="password" autocomplete="new-password"
                               minlength="8" maxlength="72" required aria-describedby="password-hint">
                        <p class="hint" id="password-hint">8 to 72 characters.</p>
                    </div>

                    <div class="field">
                        <label for="confirm_password">Confirm new password</label>
                        <input id="confirm_password" name="confirm_password" type="password" autocomplete="new-password" required>
                    </div>

                    <button class="auth-btn" type="submit">Save password and log in</button>
                </form>
            <% } %>

            <p class="auth-switch"><a href="/login">Back to log in</a></p>
        </section>
    </main>
</body>
</html>
