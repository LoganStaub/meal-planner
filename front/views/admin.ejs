<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Admin | Preply</title>
<link rel="icon" type="image/svg+xml" href="/images/logo.svg">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/admin.css">
<link rel="stylesheet" href="/css/page-card.css">
<link rel="stylesheet" href="/css/profile-menu.css">
<link rel="stylesheet" href="/css/page-header.css">
<link rel="stylesheet" href="/css/site-nav.css">
<script src="/js/no-back-cache.js"></script>
</head>
<body class="has-site-nav">

<%- include('partials/page-header', { pageTitle: 'Admin' }) %>

<div class="admin page-card">
  <header class="admin-top">
    <div>
      <p class="admin-eyebrow">Admin dashboard</p>
      <h1>OKR metrics</h1>
      <p class="admin-lede">How Preply is doing against this period's goals. Select an OKR to see its breakdown.</p>
    </div>
    <a class="admin-back" href="/home">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Back to Preply
    </a>
  </header>

  <%# One card per OKR, from OKRS in back/src/routes/admin.js. Tracked ones
      link to their breakdown (views/admin-okr.ejs). %>
  <main class="okr-grid" aria-label="OKRs">
    <% okrs.forEach(function (okr) { %>
    <% const tag = okr.tracked ? 'a' : 'div'; %>
    <<%= tag %> class="okr-card<%= okr.tracked ? '' : ' is-placeholder' %>"<% if (okr.tracked) { %> href="<%= okr.href %>"<% } %>>
      <div class="okr-card-top">
        <span class="okr-label"><%= okr.label %></span>
        <span class="okr-status <%= okr.status.tone %>"><%= okr.status.text %></span>
      </div>
      <h2><%= okr.title %></h2>
      <p class="okr-card-value<%= okr.headline.value === '—' ? ' is-empty' : '' %>"><%= okr.headline.value %></p>
      <p class="okr-card-caption"><%= okr.headline.caption %></p>
      <% if (okr.tracked) { %>
      <span class="okr-card-link">View breakdown<svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9 18 6-6-6-6"/></svg></span>
      <% } %>
    </<%= tag %>>
    <% }); %>
  </main>
</div>

<%- include('partials/site-nav') %>
<%- include('partials/profile-menu') %>
<script src="/js/profile-menu.js" defer></script>
</body>
</html>
