<!doctype html>
<html lang="en">
<head>
<%- include('partials/head', { title: okr.label + ' | Admin', styles: ['admin', 'page-card', 'profile-menu', 'page-header', 'site-nav'] }) %>
</head>
<body class="has-site-nav">

<%- include('partials/page-header', { pageTitle: 'Admin' }) %>

<%# One OKR's breakdown. The data comes from its load() in back/src/routes/admin.js. %>
<div class="admin page-card">
  <a class="admin-crumb" href="/admin">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
    All OKRs
  </a>

  <header class="admin-top">
    <div>
      <p class="admin-eyebrow"><%= okr.label %> · Target <%= okr.target %></p>
      <h1><%= okr.title %></h1>
      <p class="admin-lede"><%= okr.description %></p>
    </div>
    <span class="okr-status okr-status-lg <%= okr.status.tone %>"><%= okr.status.text %></span>
  </header>

  <main class="okr-detail">
    <div class="admin-metrics">
      <% okr.stats.forEach(function (m) { %>
      <article class="metric">
        <p class="metric-label"><%= m.label %></p>
        <p class="metric-value<%= m.value === '—' ? ' is-empty' : '' %>"><%= m.value %></p>
        <% if (m.note) { %><p class="metric-note"><%= m.note %></p><% } %>
      </article>
      <% }); %>
    </div>

    <% if (okr.note) { %><p class="okr-note" role="note"><%= okr.note %></p><% } %>

    <% if (okr.breakdown) { %>
    <section class="okr-breakdown" aria-labelledby="breakdown-title">
      <h2 id="breakdown-title"><%= okr.breakdown.title %></h2>
      <% if (okr.breakdown.rows.length === 0) { %>
      <p class="okr-empty">No attempts yet.</p>
      <% } else { %>
      <div class="okr-table-wrap">
        <table>
          <thead><tr><% okr.breakdown.columns.forEach(function (c) { %><th scope="col"><%= c %></th><% }); %></tr></thead>
          <tbody>
            <% okr.breakdown.rows.forEach(function (row) { %>
            <tr><% row.forEach(function (cell, i) { %><% if (i === 0) { %><th scope="row"><%= cell %></th><% } else { %><td><%= cell %></td><% } %><% }); %></tr>
            <% }); %>
          </tbody>
        </table>
      </div>
      <% } %>
    </section>
    <% } %>

    <% if (okr.followUp) { %>
    <%# An extra measure shown under the breakdown (e.g. OKR 1's follow-through); not part of pass/fail %>
    <section class="okr-breakdown" aria-labelledby="follow-up-title">
      <h2 id="follow-up-title"><%= okr.followUp.title %></h2>
      <% if (okr.followUp.description) { %><p class="okr-footnote"><%= okr.followUp.description %></p><% } %>
      <div class="admin-metrics">
        <% okr.followUp.stats.forEach(function (m) { %>
        <article class="metric">
          <p class="metric-label"><%= m.label %></p>
          <p class="metric-value<%= m.value === '—' ? ' is-empty' : '' %>"><%= m.value %></p>
          <% if (m.note) { %><p class="metric-note"><%= m.note %></p><% } %>
        </article>
        <% }); %>
      </div>
    </section>
    <% } %>

    <% if (okr.footnote) { %><p class="okr-footnote"><%= okr.footnote %></p><% } %>
  </main>
</div>

<%- include('partials/site-nav') %>
<%- include('partials/profile-menu') %>
<script src="<%= asset('/js/profile-menu.js') %>" defer></script>
</body>
</html>
