<!doctype html>
<html lang="en">
<head>
<%- include('partials/head', { title: 'Maintain users', styles: ['admin', 'admin-manage', 'page-card', 'profile-menu', 'page-header', 'site-nav'] }) %>
</head>
<body class="has-site-nav">

<%- include('partials/page-header', { pageTitle: 'Maintain users' }) %>

<%# Maintain Users: js/admin-users.js fills the table from /api/admin/users.
    data-current-user-id lets the page stop an admin deleting themselves. %>
<div class="admin page-card" id="manage-page" data-current-user-id="<%= currentUser.user_id %>">
  <header class="admin-top">
    <div>
      <p class="admin-eyebrow">Admin dashboard</p>
      <h1>Maintain users</h1>
      <p class="admin-lede">Add, edit and delete the people who use Preply.</p>
    </div>
    <a class="admin-back" href="/admin">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m15 18-6-6 6-6"/></svg>
      Back to admin
    </a>
  </header>

  <main>
    <div class="manage-toolbar">
      <button class="manage-btn" id="manage-add" type="button">Add user</button>
      <input type="search" id="manage-filter" placeholder="Search by name or email" aria-label="Search users">
      <span class="manage-count" id="manage-count" role="status"></span>
    </div>

    <p class="manage-status" id="manage-status" role="status" hidden></p>

    <div class="manage-table-wrap">
      <table class="manage-table">
        <thead>
          <tr><th>Name</th><th>Email</th><th>Phone</th><th>Role</th><th><span class="visually-hidden">Actions</span></th></tr>
        </thead>
        <tbody id="manage-rows"></tbody>
      </table>
      <p class="manage-empty" id="manage-empty" hidden>No users found.</p>
    </div>
  </main>
</div>

<%# Add / edit popup (one form for both) %>
<dialog class="manage-dialog" id="user-dialog" aria-labelledby="user-dialog-title">
  <form id="user-form">
    <h2 id="user-dialog-title">Add user</h2>
    <div class="manage-fields">
      <label>First name<input name="first_name" required maxlength="80" autocomplete="off"></label>
      <label>Last name<input name="last_name" required maxlength="80" autocomplete="off"></label>
      <label class="full">Email<input name="email" type="email" required maxlength="200" autocomplete="off"></label>
      <label class="full">Phone (optional)<input name="phone" type="tel" maxlength="40" autocomplete="off"></label>
      <label class="full">Password
        <input name="password" id="user-password" type="password" autocomplete="new-password">
        <small id="user-password-hint">At least 8 characters.</small>
      </label>
      <label class="check full"><input type="checkbox" name="is_admin" id="user-is-admin"> Admin (can open this dashboard and change data)</label>
    </div>
    <p class="manage-error" id="user-error" role="alert" hidden></p>
    <div class="manage-dialog-actions">
      <button class="manage-btn secondary" type="button" data-close>Cancel</button>
      <button class="manage-btn" type="submit" id="user-save">Save</button>
    </div>
  </form>
</dialog>

<%# Delete confirmation %>
<dialog class="manage-dialog" id="delete-dialog" aria-labelledby="delete-dialog-title">
  <form method="dialog" id="delete-form">
    <h2 id="delete-dialog-title">Delete this user?</h2>
    <p id="delete-text"></p>
    <p class="manage-error" id="delete-error" role="alert" hidden></p>
    <div class="manage-dialog-actions">
      <button class="manage-btn secondary" type="button" data-close>Cancel</button>
      <button class="manage-btn danger" type="button" id="delete-confirm">Delete</button>
    </div>
  </form>
</dialog>

<%- include('partials/site-nav') %>
<%- include('partials/profile-menu') %>
<script src="<%= asset('/js/profile-menu.js') %>" defer></script>
<script src="<%= asset('/js/admin-users.js') %>" defer></script>
</body>
</html>