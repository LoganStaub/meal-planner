<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title>Calendar | Preply</title>
    <link rel="icon" type="image/svg+xml" href="/images/logo.svg">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:opsz,wght@9..40,400;9..40,500;9..40,600;9..40,700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/css/calendar.css">
    <link rel="stylesheet" href="/css/page-header.css">
    <link rel="stylesheet" href="/css/profile-menu.css">
    <script src="/js/no-back-cache.js"></script>
</head>

<body>
    <svg width="0" height="0" style="position: absolute" aria-hidden="true">
        <symbol id="icon-chevron-left" viewBox="0 0 24 24"><path d="m15 18-6-6 6-6"/></symbol>
        <symbol id="icon-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
        <symbol id="icon-calendar" viewBox="0 0 24 24"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="M8 14h.01"/><path d="M12 14h.01"/><path d="M16 14h.01"/><path d="M8 18h.01"/><path d="M12 18h.01"/><path d="M16 18h.01"/></symbol>
        <symbol id="icon-list" viewBox="0 0 24 24"><path d="m3 17 2 2 4-4"/><path d="m3 7 2 2 4-4"/><path d="M13 6h8"/><path d="M13 12h8"/><path d="M13 18h8"/></symbol>
        <symbol id="icon-home" viewBox="0 0 24 24"><path d="M15 21v-8a1 1 0 0 0-1-1h-4a1 1 0 0 0-1 1v8"/><path d="M3 10a2 2 0 0 1 .709-1.528l7-5.999a2 2 0 0 1 2.582 0l7 5.999A2 2 0 0 1 21 10v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></symbol>
        <symbol id="icon-recipes" viewBox="0 0 24 24"><path d="M12 7v14"/><path d="M3 18a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1h5a4 4 0 0 1 4 4 4 4 0 0 1 4-4h5a1 1 0 0 1 1 1v13a1 1 0 0 1-1 1h-6a3 3 0 0 0-3 3 3 3 0 0 0-3-3z"/></symbol>
        <symbol id="icon-basket" viewBox="0 0 24 24"><path d="m15 11-1 9"/><path d="m19 11-4-7"/><path d="M2 11h20"/><path d="m3.5 11 1.6 7.4a2 2 0 0 0 2 1.6h9.8a2 2 0 0 0 2-1.6l1.7-7.4"/><path d="M4.5 15.5h15"/><path d="m5 11 4-7"/><path d="m9 11 1 9"/></symbol>
        <symbol id="icon-plus" viewBox="0 0 24 24"><path d="M12 5v14"/><path d="M5 12h14"/></symbol>
        <symbol id="icon-x" viewBox="0 0 24 24"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></symbol>
        <symbol id="icon-chevron-down" viewBox="0 0 24 24"><path d="m6 9 6 6 6-6"/></symbol>
    </svg>

    <div class="app">
        <%- include('partials/page-header', { pageTitle: 'Calendar' }) %>

        <main class="content">
            <div class="calendar-content">
                <section class="week-switcher" aria-label="Choose week">
                    <button type="button" class="week-arrow" id="previous-week" aria-label="Previous week">
                        <svg class="icon"><use href="#icon-chevron-left"/></svg>
                    </button>
                    <div class="week-label" aria-live="polite">
                        <h2>
                            <button type="button" class="month-toggle" id="open-month" aria-haspopup="dialog">
                                <span id="week-range"></span><span class="visually-hidden">, open month view</span>
                                <svg class="icon"><use href="#icon-chevron-down"/></svg>
                            </button>
                        </h2>
                        <p id="week-relative"></p>
                    </div>
                    <button type="button" class="week-arrow" id="next-week" aria-label="Next week">
                        <svg class="icon"><use href="#icon-chevron-right"/></svg>
                    </button>
                </section>

                <section class="week-days" id="week-days" aria-label="Days of the week"></section>

                <div class="page-error" id="page-error" role="alert" hidden>
                    <p id="page-error-message"></p>
                    <button type="button" id="page-error-retry" hidden>Try again</button>
                </div>

                <section class="selected-day" id="selected-day" data-state="loading" aria-labelledby="selected-heading">
                    <p class="selected-date" id="selected-date"></p>
                    <div class="selected-heading-row">
                        <h2 id="selected-heading">What's cooking</h2>
                        <a class="add-btn" id="add-meal" href="/recipes" aria-label="Add a meal">
                            <svg class="icon"><use href="#icon-plus"/></svg>
                        </a>
                    </div>
                    <%# Filled by calendar.js: Breakfast / Lunch / Dinner groups, then Snacks & desserts %>
                    <div class="meal-list" id="meal-list"></div>
                    <div class="empty-state">
                        <p>Nothing planned yet</p>
                        <a class="find-recipe" id="find-recipe" href="/recipes">Find a recipe</a>
                    </div>
                </section>
            </div>
        </main>

        <nav class="nav" aria-label="Main">
            <p class="nav-brand"><img class="brand-logo" src="/images/logo.svg" alt="" width="28" height="28">Preply<span>.</span></p>
            <ul>
                <li><a class="nav-link" href="/calendar" aria-current="page"><span class="nav-icon"><svg class="icon"><use href="#icon-calendar"/></svg></span>Calendar</a></li>
                <li><a class="nav-link" href="/shopping"><span class="nav-icon"><svg class="icon"><use href="#icon-list"/></svg></span>Shopping</a></li>
                <li class="nav-home"><a class="nav-link" href="/home"><span class="nav-icon"><svg class="icon"><use href="#icon-home"/></svg></span>Home</a></li>
                <li><a class="nav-link" href="/recipes"><span class="nav-icon"><svg class="icon"><use href="#icon-recipes"/></svg></span>Recipes</a></li>
                <li><a class="nav-link" href="/pantry"><span class="nav-icon"><svg class="icon"><use href="#icon-basket"/></svg></span>Pantry</a></li>
            </ul>
        </nav>
    </div>

    <dialog class="confirm-dialog" id="confirm-remove" aria-labelledby="confirm-remove-title" aria-describedby="confirm-remove-text">
        <form method="dialog">
            <div class="confirm-icon" aria-hidden="true">
                <svg class="icon"><use href="#icon-x"/></svg>
            </div>
            <h2 id="confirm-remove-title">Remove this meal?</h2>
            <p id="confirm-remove-text"></p>
            <div class="confirm-actions">
                <button type="submit" value="cancel" autofocus>Cancel</button>
                <button type="submit" value="remove" class="confirm-danger">Remove</button>
            </div>
        </form>
    </dialog>

    <dialog class="month-picker" id="month-picker" aria-labelledby="month-title">
        <div class="month-picker-body">
            <div class="month-header">
                <button type="button" class="month-arrow" id="previous-month" aria-label="Previous month">
                    <svg class="icon"><use href="#icon-chevron-left"/></svg>
                </button>
                <h2 id="month-title" aria-live="polite"></h2>
                <button type="button" class="month-arrow" id="next-month" aria-label="Next month">
                    <svg class="icon"><use href="#icon-chevron-right"/></svg>
                </button>
            </div>
            <div class="month-weekdays" aria-hidden="true">
                <span>Sun</span><span>Mon</span><span>Tue</span><span>Wed</span><span>Thu</span><span>Fri</span><span>Sat</span>
            </div>
            <div class="month-grid" id="month-grid"></div>
            <p class="month-status" id="month-status" role="status"></p>
            <div class="month-footer">
                <button type="button" id="month-today">Today</button>
                <button type="button" id="close-month">Close</button>
            </div>
        </div>
    </dialog>

    <%- include('partials/profile-menu') %>
    <script src="/js/profile-menu.js" defer></script>
    <script src="/js/calendar.js" defer></script>
</body>
</html>
