# Copy this file to .env and fill in the values.
# Find them in Supabase: Project Settings -> API Keys (and Project URL on the project home page)
# NEVER put the secret key (sb_secret_...) in this file or in frontend code.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
