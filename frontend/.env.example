# Copy this file to .env and fill in the values.
# Find them in Supabase: Project Settings -> API Keys (and Project URL on the project home page)
# NEVER put the secret key (sb_secret_...) in this file or in frontend code.
# The VITE_ prefix is required — Vite only exposes variables that start with it.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
