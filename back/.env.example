# Copy this file to .env and fill in the values. .env is git-ignored.

# Postgres connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For a local Postgres install with a database named meal_planner:
DATABASE_URL=postgres://postgres:your-password@localhost:5432/meal_planner

# Port the Express server listens on
PORT=3000

# Signs the login session cookie. Use a long random string, different per machine.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=replace-with-a-long-random-string

# Email verification. Links in emails start with APP_URL.
APP_URL=http://localhost:3000

# SMTP server for sending emails. Leave SMTP_HOST empty to print emails in the
# server console instead (fine for local testing).
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your Gmail address,
#        SMTP_PASS=an App Password (Google Account -> Security -> App passwords)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Meal Planner <your-address@example.com>"
