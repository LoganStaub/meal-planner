# Copy this file to .env and fill in the values. .env is git-ignored.

# Postgres connection string: postgres://USER:PASSWORD@HOST:PORT/DATABASE
# For a local Postgres install with a database named meal_planner:
DATABASE_URL=postgres://postgres:your-password@localhost:5432/meal_planner

# Port the Express server listens on
PORT=3000

# Claude API key for the Search page's "Add your own recipe" assistant.
# Create one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=your-anthropic-api-key

# Stand-in for login until it is built: every request is treated as this
# user (see src/currentUser.js). Do not set this on the deployed app.
DEV_USER_ID=1
